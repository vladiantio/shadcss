---
import "@/styles/loseta.css";
import "@/styles/docs.css";
import { ClientRouter } from "astro:transitions";
import { MonitorIcon, MoonIcon, SunIcon } from "@lucide/astro";
import TableOfContents from "@/components/TableOfContents.astro";
import { componentGroups, componentsInGroup } from "@/data/components";
import { addHeadingAnchors } from "@/lib/toc";
import registry from "../../../packages/loseta/registry/registry.json" with { type: "json" };

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "loseta",
  description = "Native CSS component scaffolds with the shadcn feel."
} = Astro.props;

const slotHtml = await Astro.slots.render("default");
// Render once so heading anchors and the table of contents share the same ids.
const { html: pageHtml, headings } = addHeadingAnchors(slotHtml);
const hasToc = headings.length > 0;

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(`${href}/`);
const pageTitle = title === "loseta" ? "loseta — Native CSS component scaffolds" : `${title} — loseta`;
const defaultStyle = registry.styles[0]?.name ?? "nova";
---

<!doctype html>
<html lang="en" data-package-manager="pnpm">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <ClientRouter fallback="swap" />
    <link rel="stylesheet" href={`/styles/${defaultStyle}.css`} data-style-link />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        let scheme = "system";
        let style = "nova";
        let packageManager = "pnpm";

        try {
          const storedScheme = localStorage.getItem("scheme");
          if (storedScheme === "system" || storedScheme === "light" || storedScheme === "dark") {
            scheme = storedScheme;
          }
          const storedStyle = localStorage.getItem("style");
          if (storedStyle && /^[a-z][a-z0-9-]*$/.test(storedStyle)) {
            style = storedStyle;
          }
          const storedManager = localStorage.getItem("package-manager");
          if (storedManager === "pnpm" || storedManager === "npm") {
            packageManager = storedManager;
          }
        } catch {
          // Storage can be unavailable; keep the defaults.
        }

        document
          .querySelector("[data-style-link]")
          ?.setAttribute("href", `/styles/${style}.css`);

        root.classList.toggle(
          "dark",
          scheme === "dark" || (scheme === "system" && media.matches)
        );
        root.dataset.js = "true";
        root.dataset.scheme = scheme;
        root.dataset.packageManager = packageManager;
      })();
    </script>
  </head>
  <body>
    <a class="docs-skip-link" href="#content">Skip to content</a>
    <div
      class="docs-progress"
      data-route-progress
      transition:persist="docs-progress"
      aria-hidden="true"
    ></div>
    <header class="docs-header" transition:persist="docs-header">
      <a class="docs-brand" href="/">
        <img src="/favicon.svg" alt="" width="24" height="24" />
        <span><strong>loseta</strong></span>
      </a>
      <nav class="docs-header-nav" aria-label="Main">
        <a class="docs-header-link" href="/docs">Docs</a>
        <a
          class="docs-header-link"
          href="https://github.com/vladiantio/loseta"
          target="_blank"
          rel="noreferrer"
        >
          GitHub
        </a>
        <label class="docs-style-picker">
          <span class="sr-only">Style</span>
          <select class="docs-style-select" data-style-select>
            {
              registry.styles.map((style) => (
                <option value={style.name}>{style.title}</option>
              ))
            }
          </select>
        </label>
        <div class="docs-scheme-switch" role="group" aria-label="Color scheme">
          <button
            class="docs-scheme-button"
            type="button"
            data-scheme-value="system"
            aria-label="System color scheme"
            title="System color scheme"
          >
            <MonitorIcon class="docs-scheme-icon" />
          </button>
          <button
            class="docs-scheme-button"
            type="button"
            data-scheme-value="light"
            aria-label="Light color scheme"
            title="Light color scheme"
          >
            <SunIcon class="docs-scheme-icon" />
          </button>
          <button
            class="docs-scheme-button"
            type="button"
            data-scheme-value="dark"
            aria-label="Dark color scheme"
            title="Dark color scheme"
          >
            <MoonIcon class="docs-scheme-icon" />
          </button>
        </div>
      </nav>
    </header>

    <div class:list={["docs-shell", { "docs-shell-toc": hasToc }]}>
      <aside class="docs-sidebar" transition:persist="docs-sidebar">
        <nav class="docs-nav" aria-label="Documentation">
          <div class="docs-nav-group">
            <span class="docs-nav-title">Getting started</span>
            <a
              class="docs-nav-link"
              href="/docs"
              aria-current={pathname === "/docs" ? "page" : undefined}>Overview</a
            >
            <a
              class="docs-nav-link"
              href="/docs/installation"
              aria-current={isActive("/docs/installation") ? "page" : undefined}
              >Installation</a
            >
            <a
              class="docs-nav-link"
              href="/docs/theming"
              aria-current={isActive("/docs/theming") ? "page" : undefined}>Theming</a
            >
            <a
              class="docs-nav-link"
              href="/docs/styles"
              aria-current={isActive("/docs/styles") ? "page" : undefined}>Styles</a
            >
            <a
              class="docs-nav-link"
              href="/docs/components"
              aria-current={pathname === "/docs/components" ? "page" : undefined}
              >Components</a
            >
          </div>
          {
            componentGroups.map((group) => (
              <div class="docs-nav-group">
                <span class="docs-nav-title">{group}</span>
                {componentsInGroup(group).map((component) => (
                  <a
                    class="docs-nav-link"
                    href={`/docs/components/${component.id}`}
                    aria-current={
                      pathname === `/docs/components/${component.id}` ? "page" : undefined
                    }
                  >
                    {component.title}
                  </a>
                ))}
              </div>
            ))
          }
        </nav>
      </aside>

      <main class="docs-main" id="content">
        <Fragment set:html={pageHtml} />
        <footer class="docs-footer" transition:persist="docs-footer">
          <p>
            loseta is MIT licensed. Built with native CSS, no runtime. Inspired by
            <a href="https://ui.shadcn.com" target="_blank" rel="noreferrer">shadcn/ui</a>.
          </p>
        </footer>
      </main>

      {hasToc && <TableOfContents headings={headings} />}
    </div>

    <script>
      import "@/scripts/docs-client";
    </script>
  </body>
</html>
