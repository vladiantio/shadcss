---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>shadcss</title>
    <script>
      const matchDarkScheme = window.matchMedia("(prefers-color-scheme: dark)");
      const updateTheme = () => {
        const theme = localStorage.theme || "system";
        document.documentElement.classList.toggle(
          "dark",
          theme === "dark" || (theme === "system" && matchDarkScheme.matches)
        );
      };
      updateTheme();
      matchDarkScheme.addEventListener("change", updateTheme);
      window.addEventListener("storage", updateTheme);
    </script>
  </head>
  <body>
    <div
      class="flex flex-col gap-4 items-start justify-center min-h-dvh mx-auto max-w-5xl px-4 py-6"
    >
      <slot />
    </div>
  </body>
</html>
