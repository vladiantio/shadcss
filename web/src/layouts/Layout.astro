---
import "@/styles/loseta.css";
import "@/styles/docs.css";
import { ClientRouter } from "astro:transitions";
import { MonitorIcon, MoonIcon, SunIcon } from "@lucide/astro";
import TableOfContents from "@/components/TableOfContents.astro";
import { componentGroups, componentsInGroup } from "@/data/components";
import { addHeadingAnchors } from "@/lib/toc";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "loseta",
  description = "Native CSS component scaffolds with the shadcn feel."
} = Astro.props;

const slotHtml = await Astro.slots.render("default");
// Render once so heading anchors and the table of contents share the same ids.
const { html: pageHtml, headings } = addHeadingAnchors(slotHtml);
const hasToc = headings.length > 0;

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(`${href}/`);
const pageTitle = title === "loseta" ? "loseta — Native CSS component scaffolds" : `${title} — loseta`;
---

<!doctype html>
<html lang="en" data-package-manager="pnpm">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <ClientRouter fallback="swap" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const themes = ["system", "light", "dark"];

        const getTheme = () => {
          try {
            const stored = localStorage.getItem("theme");
            return themes.includes(stored) ? stored : "system";
          } catch {
            return "system";
          }
        };

        const apply = (theme) => {
          root.classList.toggle(
            "dark",
            theme === "dark" || (theme === "system" && media.matches)
          );
          root.dataset.theme = theme;
          document.querySelectorAll("[data-theme-value]").forEach((button) => {
            button.setAttribute("aria-pressed", String(button.dataset.themeValue === theme));
          });
        };

        apply(getTheme());
        document.addEventListener("DOMContentLoaded", () => apply(getTheme()));
        media.addEventListener("change", () => {
          if (getTheme() === "system") apply("system");
        });
        document.addEventListener("click", (event) => {
          if (!(event.target instanceof Element)) return;
          const button = event.target.closest("[data-theme-value]");
          if (!button) return;
          const theme = button.dataset.themeValue;
          if (!themes.includes(theme)) return;
          try {
            localStorage.setItem("theme", theme);
          } catch {
            // Storage can be unavailable; the switch still works for this page.
          }
          apply(theme);
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const managers = ["pnpm", "npm"];
        try {
          const stored = localStorage.getItem("package-manager");
          if (managers.includes(stored)) {
            document.documentElement.dataset.packageManager = stored;
          }
        } catch {
          // Storage can be unavailable; keep the pnpm default.
        }
      })();
    </script>
  </head>
  <body>
    <a class="docs-skip-link" href="#content">Skip to content</a>
    <div
      class="docs-progress"
      data-route-progress
      transition:persist="docs-progress"
      aria-hidden="true"
    ></div>
    <header class="docs-header" transition:persist="docs-header">
      <a class="docs-brand" href="/">
        <img src="/favicon.svg" alt="" width="24" height="24" />
        <span><strong>loseta</strong></span>
      </a>
      <nav class="docs-header-nav" aria-label="Main">
        <a class="docs-header-link" href="/docs">Docs</a>
        <a
          class="docs-header-link"
          href="https://github.com/vladiantio/loseta"
          target="_blank"
          rel="noreferrer"
        >
          GitHub
        </a>
        <div class="docs-theme-switch" role="group" aria-label="Color theme">
          <button
            class="docs-theme-button"
            type="button"
            data-theme-value="system"
            aria-label="System theme"
            title="System theme"
          >
            <MonitorIcon class="docs-theme-icon" />
          </button>
          <button
            class="docs-theme-button"
            type="button"
            data-theme-value="light"
            aria-label="Light theme"
            title="Light theme"
          >
            <SunIcon class="docs-theme-icon" />
          </button>
          <button
            class="docs-theme-button"
            type="button"
            data-theme-value="dark"
            aria-label="Dark theme"
            title="Dark theme"
          >
            <MoonIcon class="docs-theme-icon" />
          </button>
        </div>
      </nav>
    </header>

    <div class:list={["docs-shell", { "docs-shell-toc": hasToc }]}>
      <aside class="docs-sidebar" transition:persist="docs-sidebar">
        <nav class="docs-nav" aria-label="Documentation">
          <div class="docs-nav-group">
            <span class="docs-nav-title">Getting started</span>
            <a
              class="docs-nav-link"
              href="/docs"
              aria-current={pathname === "/docs" ? "page" : undefined}>Overview</a
            >
            <a
              class="docs-nav-link"
              href="/docs/installation"
              aria-current={isActive("/docs/installation") ? "page" : undefined}
              >Installation</a
            >
            <a
              class="docs-nav-link"
              href="/docs/theming"
              aria-current={isActive("/docs/theming") ? "page" : undefined}>Theming</a
            >
            <a
              class="docs-nav-link"
              href="/docs/components"
              aria-current={pathname === "/docs/components" ? "page" : undefined}
              >Components</a
            >
          </div>
          {
            componentGroups.map((group) => (
              <div class="docs-nav-group">
                <span class="docs-nav-title">{group}</span>
                {componentsInGroup(group).map((component) => (
                  <a
                    class="docs-nav-link"
                    href={`/docs/components/${component.id}`}
                    aria-current={
                      pathname === `/docs/components/${component.id}` ? "page" : undefined
                    }
                  >
                    {component.title}
                  </a>
                ))}
              </div>
            ))
          }
        </nav>
      </aside>

      <main class="docs-main" id="content" tabindex="-1">
        <Fragment set:html={pageHtml} />
        <footer class="docs-footer" transition:persist="docs-footer">
          <p>
            loseta is MIT licensed. Built with native CSS, no runtime. Inspired by
            <a href="https://ui.shadcn.com" target="_blank" rel="noreferrer">shadcn/ui</a>.
          </p>
        </footer>
      </main>

      {hasToc && <TableOfContents headings={headings} />}
    </div>

    <script>
      import "@/scripts/navigation.js";
      import "@/demo/site.js";
    </script>
  </body>
</html>
