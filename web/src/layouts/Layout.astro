---
import "../styles/shadcss.css";
import "../styles/docs.css";
import { componentGroups, componentsInGroup } from "../data/components";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "shadcss",
  description = "Native CSS component scaffolds with the shadcn feel."
} = Astro.props;

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(`${href}/`);
const pageTitle = title === "shadcss" ? "shadcss — Native CSS component scaffolds" : `${title} — shadcss`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <script is:inline>
      const root = document.documentElement;
      const media = window.matchMedia("(prefers-color-scheme: dark)");
      const themes = ["system", "light", "dark"];

      const getTheme = () => {
        const stored = localStorage.getItem("theme");
        return themes.includes(stored) ? stored : "system";
      };

      const apply = (theme) => {
        root.classList.toggle(
          "dark",
          theme === "dark" || (theme === "system" && media.matches)
        );
        root.dataset.theme = theme;
        document.querySelectorAll("[data-theme-value]").forEach((button) => {
          button.setAttribute("aria-pressed", String(button.dataset.themeValue === theme));
        });
      };

      apply(getTheme());
      document.addEventListener("DOMContentLoaded", () => apply(getTheme()));
      media.addEventListener("change", () => {
        if (getTheme() === "system") apply("system");
      });
      document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;
        const button = event.target.closest("[data-theme-value]");
        if (!button) return;
        const theme = button.dataset.themeValue;
        if (!themes.includes(theme)) return;
        localStorage.setItem("theme", theme);
        apply(theme);
      });
    </script>
  </head>
  <body>
    <header class="docs-header">
      <a class="docs-brand" href="/">
        <img src="/favicon.svg" alt="" width="24" height="24" />
        <span>shad<strong>css</strong></span>
      </a>
      <nav class="docs-header-nav" aria-label="Main">
        <a class="docs-header-link" href="/docs">Docs</a>
        <a
          class="docs-header-link"
          href="https://github.com/vladiantio/shadcss"
          target="_blank"
          rel="noreferrer"
        >
          GitHub
        </a>
        <div class="docs-theme-switch" role="group" aria-label="Color theme">
          <button
            class="docs-theme-button"
            type="button"
            data-theme-value="system"
            aria-label="System theme"
            title="System theme"
          >
            <svg
              class="docs-theme-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="20" height="14" x="2" y="3" rx="2"></rect>
              <line x1="8" x2="16" y1="21" y2="21"></line>
              <line x1="12" x2="12" y1="17" y2="21"></line>
            </svg>
          </button>
          <button
            class="docs-theme-button"
            type="button"
            data-theme-value="light"
            aria-label="Light theme"
            title="Light theme"
          >
            <svg
              class="docs-theme-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
          </button>
          <button
            class="docs-theme-button"
            type="button"
            data-theme-value="dark"
            aria-label="Dark theme"
            title="Dark theme"
          >
            <svg
              class="docs-theme-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <div class="docs-shell">
      <aside class="docs-sidebar">
        <nav class="docs-nav" aria-label="Documentation">
          <div class="docs-nav-group">
            <span class="docs-nav-title">Getting started</span>
            <a
              class="docs-nav-link"
              href="/docs"
              aria-current={pathname === "/docs" ? "page" : undefined}>Overview</a
            >
            <a
              class="docs-nav-link"
              href="/docs/installation"
              aria-current={isActive("/docs/installation") ? "page" : undefined}
              >Installation</a
            >
            <a
              class="docs-nav-link"
              href="/docs/theming"
              aria-current={isActive("/docs/theming") ? "page" : undefined}>Theming</a
            >
            <a
              class="docs-nav-link"
              href="/docs/components"
              aria-current={pathname === "/docs/components" ? "page" : undefined}
              >Components</a
            >
          </div>
          {
            componentGroups.map((group) => (
              <div class="docs-nav-group">
                <span class="docs-nav-title">{group}</span>
                {componentsInGroup(group).map((component) => (
                  <a
                    class="docs-nav-link"
                    href={`/docs/components/${component.id}`}
                    aria-current={
                      pathname === `/docs/components/${component.id}` ? "page" : undefined
                    }
                  >
                    {component.title}
                  </a>
                ))}
              </div>
            ))
          }
        </nav>
      </aside>

      <main class="docs-main" id="content">
        <slot />
        <footer class="docs-footer">
          <p>
            shadcss is MIT licensed. Built with native CSS, no runtime. Inspired by
            <a href="https://ui.shadcn.com" target="_blank" rel="noreferrer">shadcn/ui</a>.
          </p>
        </footer>
      </main>
    </div>

    <script>
      import "../demo/site.js";
    </script>
  </body>
</html>
