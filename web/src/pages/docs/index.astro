---
import Layout from "@/layouts/Layout.astro";
import InstallCommand from "@/components/InstallCommand.astro";
import CodeBlock from "@/components/CodeBlock.astro";
import { components } from "@/data/components";
---

<Layout title="Documentation" description="Install, configure and customize loseta.">
  <div class="docs-content">
    <p class="docs-eyebrow">Documentation</p>
    <h1>Native CSS scaffolds, without the runtime.</h1>
    <p class="docs-lead">
      loseta is a registry of component CSS and markup contracts. The CLI copies the files into
      your project, so you own the code and can change anything.
    </p>

    <div class="docs-grid">
      <a class="docs-card" href="/docs/installation">
        <span class="docs-card-title">Installation</span>
        <span class="docs-card-description">Initialize a project and add your first component.</span>
      </a>
      <a class="docs-card" href="/docs/theming">
        <span class="docs-card-title">Theming</span>
        <span class="docs-card-description">Tokens, dark mode, data attributes and the layer contract.</span>
      </a>
      <a class="docs-card" href="/docs/styles">
        <span class="docs-card-title">Styles</span>
        <span class="docs-card-description">Compare Vega and Nova, then install or switch styles.</span>
      </a>
      <a class="docs-card" href="/docs/components">
        <span class="docs-card-title">Components</span>
        <span class="docs-card-description">Browse the {components.length} stable components in v1.</span>
      </a>
    </div>

    <h2>How it works</h2>
    <ol>
      <li><strong>Initialize.</strong> The CLI creates the foundation files and a generated entrypoint.</li>
      <li><strong>Add components.</strong> Each item installs its base CSS, its style file and any primitive dependency.</li>
      <li><strong>Use the markup contract.</strong> Data attributes, ARIA and native elements carry the state.</li>
    </ol>

    <InstallCommand command="loseta init" />
    <InstallCommand command="loseta add button card field" />

    <h2>What gets installed</h2>
    <CodeBlock
      lang="text"
      code={`loseta.json
.loseta/manifest.json
src/styles/loseta/
  tokens.css
  reset.css
  base.css
  utilities.css
  index.css
  primitives/
  components/
  styles/nova/               # selected style`}
    />

    <div class="docs-callout">
      <strong>CSS only.</strong> Components that need interaction, such as dropdown menus and tabs,
      document the required state contract but do not ship JavaScript. The docs demos use a small
      demo-only script to keep the examples interactive.
    </div>
  </div>
</Layout>
