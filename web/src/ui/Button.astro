---
import type { HTMLAttributes } from "astro/types";
import "./button.css";

type Variant = "default" | "secondary" | "outline" | "ghost" | "link" | "destructive";

type Size = "default" | "sm" | "lg" | "icon" | "icon-sm" | "icon-lg";

type Props = HTMLAttributes<"button"> &
  Omit<HTMLAttributes<"a">, "type"> & {
    size?: Size;
    variant?: Variant;
  };

const {
  class: className,
  size,
  variant,
  ...rest
} = Astro.props;

const Tag = Astro.props.href ? "a" : "button";
---

<Tag
  class:list={["btn", className]}
  data-size={size}
  data-variant={variant}
  {...rest}
>
  <slot />
</Tag>
