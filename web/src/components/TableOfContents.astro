---
import { TextAlignStart } from "@lucide/astro";
import type { TocHeading } from "@/lib/toc";

interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;
---

<nav class="docs-toc" aria-label="Table of contents" data-toc>
  <h3 class="docs-toc-title">
    <TextAlignStart class="docs-toc-icon" aria-hidden="true" />
    On this page
  </h3>
  <div class="docs-toc-scroll" data-toc-scroll>
    <div class="docs-toc-list" data-toc-list>
      <span class="docs-toc-highlight" data-toc-highlight aria-hidden="true"></span>
      <ul class="docs-toc-items">
        {
          headings.map((heading) => (
            <li>
              <a
                class="docs-toc-link"
                href={`#${heading.slug}`}
                data-toc-link
                data-depth={heading.depth}
              >
                {heading.text}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

