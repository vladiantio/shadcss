---
import { Code } from "astro:components";
import type { CodeLanguage } from "astro";
import { shikiThemes } from "@/lib/shiki";

interface Props {
  code: string;
  lang?: CodeLanguage;
  label?: string;
}

const { code, lang = "bash", label = lang } = Astro.props;
---

<div class="code-block">
  <div class="code-block-header">
    <span>{label}</span>
    <button class="copy-button" type="button" data-copy>Copy</button>
  </div>
  <Code
    code={code.trim()}
    lang={lang}
    themes={shikiThemes}
    defaultColor={false}
    tabindex="0"
  />
</div>
