---
import { Code } from "astro:components";
import type { CodeLanguage } from "astro";
import { CheckIcon, CopyIcon } from "@lucide/astro";
import { shikiThemes } from "@/lib/shiki";

interface Props {
  code: string;
  lang?: CodeLanguage;
  label?: string;
}

const { code, lang = "bash", label = lang } = Astro.props;
---

<div class="code-block">
  <header>
    <span data-slot="title">{label}</span>
    <div data-slot="actions">
      <button
        class="btn"
        data-variant="ghost"
        data-size="icon-xs"
        type="button"
        data-copy
        data-copy-icon
        aria-label="Copy code"
      >
        <CopyIcon class="code-copy-glyph" aria-hidden="true" />
        <CheckIcon class="code-copy-glyph code-copy-check" aria-hidden="true" />
      </button>
    </div>
  </header>
  <Code
    code={code.trim()}
    lang={lang}
    themes={shikiThemes}
    defaultColor={false}
    transformers={[
      {
        // The code block styles line numbers and variants through these slots.
        name: "loseta:code-block-slots",
        line(hast) {
          hast.properties["data-slot"] = "line";
          hast.children = [
            {
              type: "element",
              tagName: "span",
              properties: { "data-slot": "line-content" },
              children: hast.children
            }
          ];
        }
      }
    ]}
    data-line-numbers
    tabindex="0"
    dir="ltr"
  />
</div>
