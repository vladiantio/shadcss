---
interface Props {
  code: string;
  lang?: string;
}

const { code, lang = "bash" } = Astro.props;
---

<div class="code-block">
  <div class="code-block-header">
    <span>{lang}</span>
    <button class="copy-button" type="button" data-copy>Copy</button>
  </div>
  <pre tabindex="0"><code>{code.trim()}</code></pre>
</div>
