---
import { Code } from "astro:components";
import type { CodeLanguage } from "astro";
import { CheckIcon, CopyIcon } from "@lucide/astro";
import { shikiThemes } from "@/lib/shiki";

interface Props {
  code: string;
  lang?: CodeLanguage;
  label?: string;
}

const { code, lang = "bash", label = lang } = Astro.props;
---

<div class="code-block">
  <header>
    <span data-slot="title">{label}</span>
    <div data-slot="actions">
      <button
        class="btn"
        data-variant="ghost"
        data-size="icon-xs"
        type="button"
        data-copy
        data-copy-icon
        aria-label="Copy code"
      >
        <CopyIcon class="code-copy-glyph" aria-hidden="true" />
        <CheckIcon class="code-copy-glyph code-copy-check" aria-hidden="true" />
      </button>
    </div>
  </header>
  <Code
    code={code.trim()}
    lang={lang}
    themes={shikiThemes}
    defaultColor={false}
    tabindex="0"
    dir="ltr"
  />
</div>
