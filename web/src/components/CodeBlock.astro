---
import { Code } from "astro:components";
import type { CodeLanguage } from "astro";
import CodeBlockCopyButton from "@/components/CodeBlockCopyButton.astro";
import { shikiThemes } from "@/lib/shiki";

interface Props {
  code: string;
  lang?: CodeLanguage;
  label?: string;
  floating?: boolean;
}

const { code, lang = "bash", label = lang, floating = false } = Astro.props;
---

<div class="code-block">
  {
    floating ? (
      <div data-slot="actions">
        <CodeBlockCopyButton />
      </div>
    ) : (
      <header>
        <span data-slot="title">{label}</span>
        <div data-slot="actions">
          <CodeBlockCopyButton />
        </div>
      </header>
    )
  }
  <Code
    code={code.trim()}
    lang={lang}
    themes={shikiThemes}
    defaultColor={false}
    wrap={null}
    transformers={[
      {
        // The code block styles line numbers and variants through these slots.
        name: "loseta:code-block-slots",
        line(hast) {
          hast.properties["data-slot"] = "line";
          hast.children = [
            {
              type: "element",
              tagName: "span",
              properties: { "data-slot": "line-content" },
              children: hast.children
            }
          ];
        }
      }
    ]}
    data-line-numbers
    tabindex="0"
    dir="ltr"
  />
</div>
