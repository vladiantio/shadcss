---
import { Code } from "astro:components";
import type { CodeLanguage } from "astro";
import { CheckIcon, CopyIcon } from "@lucide/astro";
import { shikiThemes } from "@/lib/shiki";

interface Props {
  code: string;
  lang?: CodeLanguage;
  label?: string;
}

const { code, lang = "bash", label = lang } = Astro.props;
---

<div class="code-block">
  <div class="code-block-header">
    <span>{label}</span>
    <button class="copy-button" type="button" data-copy data-copy-icon aria-label="Copy code">
      <CopyIcon class="copy-button-glyph" aria-hidden="true" />
      <CheckIcon class="copy-button-glyph copy-button-check" aria-hidden="true" />
    </button>
  </div>
  <Code
    code={code.trim()}
    lang={lang}
    themes={shikiThemes}
    defaultColor={false}
    tabindex="0"
  />
</div>
