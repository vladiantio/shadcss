---
import CodeBlock from "@/components/CodeBlock.astro";

interface Props {
  title: string;
  html: string;
}

const { title, html } = Astro.props;
---

<section class="example">
  <h3 class="example-title">{title}</h3>
  <div class="docs-preview" set:html={html} />
  <CodeBlock code={html.trim()} lang="html" label="HTML" />
</section>
