---
import { Code } from "astro:components";
import { shikiThemes } from "@/lib/shiki";

interface Props {
  command: string;
}

const { command } = Astro.props;
---

<div class="install-command">
  <Code
    code={command}
    lang="bash"
    themes={shikiThemes}
    defaultColor={false}
    inline
    tabindex="0"
  />
  <button class="copy-button" type="button" data-copy>Copy</button>
</div>
